# Copy to .env and fill in. app/config.py is the only code that reads this file.

# OpenRouter — https://openrouter.ai/keys
OPENROUTER_API_KEY=
# Vision-capable model used for edit planning + QC frame review.
# The free-tier catalog churns — check https://openrouter.ai/collections/vision-models
# before relying on a specific id. Examples seen in the free tier as of Jul 2026:
#   google/gemma-3-27b-it:free
#   nvidia/nemotron-nano-12b-v2-vl:free
OPENROUTER_MODEL=
# Used on rate-limit/429 or when the primary model is unavailable.
OPENROUTER_FALLBACK_MODEL=

# Supabase Postgres connection string (Session pooler or direct connection),
# e.g. postgresql+psycopg://postgres.xxxx:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=

# tiny | base | small | medium | large-v3 — bigger = better transcripts, slower on CPU.
WHISPER_MODEL_SIZE=small

LOG_LEVEL=INFO
